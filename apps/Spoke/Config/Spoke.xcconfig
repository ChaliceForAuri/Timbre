// Target-level settings for the Spoke app.

PRODUCT_NAME = $(TARGET_NAME)
PRODUCT_BUNDLE_IDENTIFIER = dev.hugopretorius.Spoke

// The Info.plist is generated from these keys — no plist file to drift.
GENERATE_INFOPLIST_FILE = YES

// Menu bar app: no Dock icon, no app switcher entry.
INFOPLIST_KEY_LSUIElement = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSMicrophoneUsageDescription = Spoke listens when you hold the dictation key.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Spoke transcribes your speech on-device.

// The sandbox blocks the synthetic ⌘V into other apps (ADR-0003), so it
// stays off. Hardened runtime stays on — it's required for notarization and
// costs nothing in development.
ENABLE_APP_SANDBOX = NO
ENABLE_HARDENED_RUNTIME = YES

// The hardened runtime gates the microphone behind an entitlement; the
// Info.plist usage string alone is not enough. See Spoke.entitlements.
CODE_SIGN_ENTITLEMENTS = Spoke.entitlements

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
COMBINE_HIDPI_IMAGES = YES
