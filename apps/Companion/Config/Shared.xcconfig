// Settings common to every target of the companion (ADR-0016). Debug and
// Release include this; each target adds its own file on top.

// Swift 6 language mode with the Xcode 26 template's concurrency defaults,
// matching the packages' Package.swift. See ADR-0001.
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// Automatic signing with the team in Config/Local.xcconfig (gitignored, see
// the Mac app's Local.xcconfig.template). A simulator build needs none.
CODE_SIGN_STYLE = Automatic

MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = Timbre
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
ALWAYS_SEARCH_USER_PATHS = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor

// Machine-specific overrides (signing team). Untracked; optional.
#include? "Local.xcconfig"
