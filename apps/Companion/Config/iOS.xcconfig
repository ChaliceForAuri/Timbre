// Timbre for iPhone (GDR-0023, decision 2): the Library in your pocket,
// practice, the word of the day, the to-do key. Never dictation into other
// apps.

SDKROOT = iphoneos
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO

PRODUCT_NAME = Timbre
PRODUCT_BUNDLE_IDENTIFIER = dev.hugopretorius.Timbre

// The URL scheme (the widget and the Lock Screen control open the app on a
// screen) lives in a plist; everything else is a key.
INFOPLIST_FILE = Config/iOS-Info.plist
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_UISupportedInterfaceOrientations = UIInterfaceOrientationPortrait
INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad = UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSMicrophoneUsageDescription = Timbre listens while you hold the button, for Spell it and for a spoken to-do.
INFOPLIST_KEY_NSSpeechRecognitionUsageDescription = Timbre transcribes your speech on-device.
INFOPLIST_KEY_NSRemindersFullAccessUsageDescription = Timbre adds the to-dos you say to a list in Reminders, and reads the list back to you.

// The app group the widgets read today's word from.
CODE_SIGN_ENTITLEMENTS = Config/iOS.entitlements

LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks
