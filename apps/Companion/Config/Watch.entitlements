<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app and its widgets share the Library and today's snapshot
	     through this container (ADR-0016). Nothing else is shared. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.hugopretorius.Timbre</string>
	</array>
	<!-- The Library through the user's own iCloud (GDR-0023 decision 1,
	     ADR-0017). Off until turned on in Settings; the binary still makes no
	     request — the system's daemon does the syncing. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.hugopretorius.Timbre</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
