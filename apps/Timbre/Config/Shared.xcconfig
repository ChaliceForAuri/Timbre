// Settings common to every configuration. Debug.xcconfig / Release.xcconfig
// include this file; the target adds Timbre.xcconfig on top.

SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 26.0

// Swift 6 language mode with the Xcode 26 template's concurrency defaults,
// matching TimbreKit's Package.swift. See ADR-0001.
SWIFT_VERSION = 6.0
SWIFT_APPROACHABLE_CONCURRENCY = YES
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES

// Default: ad-hoc signing, so a fresh clone builds with no account and no
// keychain prompts. Caveat: the signature changes every build, so macOS
// resets the Accessibility grant per rebuild. For daily work, put a real
// team in Config/Local.xcconfig (gitignored — see Local.xcconfig.template);
// a stable identity is what lets the Accessibility grant survive rebuilds.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

MARKETING_VERSION = 0.2.0
CURRENT_PROJECT_VERSION = 3

ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
ALWAYS_SEARCH_USER_PATHS = NO

// Machine-specific overrides (signing team, etc.). Untracked; optional.
#include? "Local.xcconfig"
