<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required because the hardened runtime is on (ADR-0003). Without it the
	     runtime blocks microphone access before TCC is ever consulted:
	     requestAccess returns false immediately, no prompt appears, and the app
	     never shows up in Privacy & Security › Microphone at all. The Info.plist
	     usage string is necessary but not sufficient. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The Library through the user's own iCloud (GDR-0023 decision 1,
	     ADR-0017). Off until turned on in Settings; the binary still makes no
	     request — the system's daemon does the syncing. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.hugopretorius.Timbre</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
</dict>
</plist>
