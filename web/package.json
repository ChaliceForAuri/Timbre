{
	"name": "web",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && node scripts/gen-architecture.mjs || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"sync:decisions": "node scripts/sync-decisions.mjs",
		"sync:plans": "node scripts/sync-plans.mjs",
		"sync:docs": "node scripts/sync-decisions.mjs && node scripts/sync-plans.mjs && node scripts/sync-releases.mjs && node scripts/sync-evals.mjs && node scripts/sync-launch.mjs && node scripts/sync-design.mjs",
		"sync:evals": "node scripts/sync-evals.mjs",
		"sync:releases": "node scripts/sync-releases.mjs",
		"sync:launch": "node scripts/sync-launch.mjs",
		"measure": "node scripts/measure-evals.mjs",
		"gen:architecture": "node scripts/gen-architecture.mjs",
		"sync:design": "node scripts/sync-design.mjs"
	},
	"devDependencies": {
		"@internationalized/date": "^3.12.3",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"likec4": "^1.59.4",
		"marked": "^18.0.13",
		"mdsvex": "^0.12.8",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "^8.2.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"brace-expansion@>=4.0.0 <5.0.12": ">=5.0.12",
			"source-map-js@<1.2.2": ">=1.2.2",
			"postcss-selector-parser@<7.1.6": ">=7.1.6"
		}
	},
	"dependencies": {
		"@lucide/svelte": "^1.48.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.112.3",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "^1.4.0"
	}
}
