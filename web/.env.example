# Backstage auth. Copy to .env for local development; set the same names in
# Vercel's project settings for production.

PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Comma-separated. Empty or unset means nobody can reach Backstage.
BACKSTAGE_ALLOWLIST=you@example.com

# Dev server only: render Backstage without signing in, as a placeholder user.
# Ignored by builds. Handy when you have no Supabase project locally.
# BACKSTAGE_LOCAL_PREVIEW=1
