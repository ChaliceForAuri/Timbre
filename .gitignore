# macOS
.DS_Store

# Xcode
xcuserdata/
DerivedData/
*.xcuserstate
*.xcscmblueprint

# Swift Package Manager
.build/
.swiftpm/

# Machine-specific build settings (signing team)
apps/Timbre/Config/Local.xcconfig

# Web (toolchain lives entirely under web/)
web/node_modules/
web/.svelte-kit/
web/.vercel/
web/build/
packages/TimbreKit/Fixtures/audio/

# Local build products (install.sh, release.sh)
build/

# Local env (never committed; Vercel holds the real values)
web/.env

# Provisioning profiles are fetched per machine (tools/asc.swift); never committed.
apps/Timbre/Config/*.provisionprofile

# The review's evidence and worktrees (tools/review.sh, GDR-0030); the
# review itself lives on the pull request.
.review/

# The maintainer's own captures, imported for evaluation: never committed
# (review.md, C5).
packages/TimbreKit/Fixtures/real-corpus.json
